generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum UserRole {
  SUPER_ADMIN
  ADMIN
  COMMUNITY_LEADER
  VOLUNTEER
  CITIZEN
}

enum CommunityRole {
  OWNER
  MODERATOR
  MEMBER
}

enum IncidentStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum IncidentCategory {
  SECURITY
  SANITATION
  HEALTH
  ROAD
  FIRE
  ENVIRONMENT
  FLOOD
  OTHER
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum NotificationType {
  SYSTEM
  COMMUNITY
  EVENT
  INCIDENT
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaContext {
  INCIDENT
  EVENT
  COMMUNITY
  PROFILE
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id       String   @id @default(cuid())
  fullName String
  email    String   @unique
  password String
  phone    String?
  role     UserRole @default(CITIZEN)

  communities      CommunityMember[]
  ownedCommunities Community[]       @relation("CommunityOwner")

  reports         IncidentReport[] @relation("IncidentReporter")
  assignedReports IncidentReport[] @relation("IncidentAssignee")

  events        EventRegistration[]
  notifications Notification[]

  media Media[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([role])
}

//////////////////////////////////////////////////////
// COMMUNITY
//////////////////////////////////////////////////////

model Community {
  id          String  @id @default(cuid())
  name        String
  state       String
  lga         String
  description String?

  // Geographic location
  latitude  Float?
  longitude Float?

  ownerId String
  owner   User   @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members   CommunityMember[]
  events    Event[]
  incidents IncidentReport[]
  media     Media[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([state])
  @@index([lga])
  @@index([latitude, longitude])
}

//////////////////////////////////////////////////////
// COMMUNITY MEMBERS
//////////////////////////////////////////////////////

model CommunityMember {
  id          String @id @default(cuid())
  userId      String
  communityId String

  role CommunityRole @default(MEMBER)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([userId, communityId])
  @@index([communityId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// INCIDENT REPORT
//////////////////////////////////////////////////////

model IncidentReport {
  id          String           @id @default(cuid())
  title       String
  description String
  category    IncidentCategory
  location    String

  // Device GPS coordinates
  latitude  Float?
  longitude Float?

  imageUrl String?

  status IncidentStatus @default(PENDING)

  reporterId   String
  communityId  String
  assignedToId String?

  reporter   User      @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  community  Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation("IncidentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  media Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([communityId])
  @@index([reporterId])
  @@index([assignedToId])
  @@index([category])
  @@index([latitude, longitude])
}

//////////////////////////////////////////////////////
// EVENTS
//////////////////////////////////////////////////////

model Event {
  id          String @id @default(cuid())
  title       String
  description String
  venue       String

  // Geographic location
  latitude  Float?
  longitude Float?

  startDate DateTime
  endDate   DateTime

  status EventStatus @default(UPCOMING)

  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  attendees EventRegistration[]
  media     Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityId])
  @@index([status])
  @@index([startDate])
  @@index([latitude, longitude])
}

//////////////////////////////////////////////////////
// EVENT REGISTRATION
//////////////////////////////////////////////////////

model EventRegistration {
  id String @id @default(cuid())

  eventId String
  userId  String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  registeredAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// MEDIA
//////////////////////////////////////////////////////

model Media {
  id String @id @default(cuid())

  // File information
  url      String
  fileName String?
  mimeType String?
  size     Int?

  type    MediaType    @default(IMAGE)
  context MediaContext

  // Ownership
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  // Optional relationship to an incident
  incidentId String?
  incident   IncidentReport? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  // Optional relationship to an event
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Optional relationship to a community
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([uploadedById])
  @@index([incidentId])
  @@index([eventId])
  @@index([communityId])
  @@index([context])
}

//////////////////////////////////////////////////////
// NOTIFICATIONS
//////////////////////////////////////////////////////

model Notification {
  id      String @id @default(cuid())
  title   String
  message String

  type NotificationType @default(SYSTEM)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}
